{
  "info": {
    "_postman_id": "6a6be45e-a66a-4e9c-bf15-70e06b9a0101",
    "name": "QandA 同步服务 API v1（当前实现）",
    "description": "用于旧版本地练习同步服务的接口集合。导入后在集合 Variables 中设置 token（本地开发/测试令牌）和 baseUrl。建议逐项按编号发送；批次接收是异步的，先在同步水位请求中等到 acceptedThroughSeq 与 appliedThroughSeq 相同，再刷新快照并交卷。默认场景覆盖创建、读取、答案上传、幂等重发、状态查询、换端、交卷和结果查询。集合包含该同步原型的 7 个路由；当前 Kotlin API 的 101 项合同见 apps/api/contracts/openapi.yaml。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "填写本地 .env 中 QANDA_TEST_TOKENS 对应用户的令牌；不要导出或共享真实令牌。"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "initialWriterId",
      "value": "device-a",
      "type": "string",
      "description": "新场次使用的初始设备标识。"
    },
    {
      "key": "writerId",
      "value": "device-a",
      "type": "string"
    },
    {
      "key": "writerEpoch",
      "value": "1",
      "type": "string"
    },
    {
      "key": "nextWriterId",
      "value": "device-b",
      "type": "string"
    },
    {
      "key": "previousWriterEpoch",
      "value": "1",
      "type": "string"
    },
    {
      "key": "packageItems",
      "value": "",
      "type": "string"
    },
    {
      "key": "snapshot",
      "value": "",
      "type": "string"
    },
    {
      "key": "acceptedThroughSeq",
      "value": "0",
      "type": "string"
    },
    {
      "key": "appliedThroughSeq",
      "value": "0",
      "type": "string"
    },
    {
      "key": "batchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "lastBatchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "takeoverRequestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "finishRequest",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 创建练习场次",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/practice/sessions",
        "description": "创建后保存 sessionId、writerEpoch、题包和初始快照。默认创建 PRACTICE。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"writerId\": \"{{writerId}}\",\n  \"mode\": \"PRACTICE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"writerId\", pm.collectionVariables.get(\"initialWriterId\") || \"device-a\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201 Created\", () => pm.response.to.have.status(201));",
              "const d = pm.response.json();",
              "pm.test(\"返回场次和20道固定题\", () => { pm.expect(d.sessionId).to.be.a(\"string\"); pm.expect(d.package.items).to.have.length(20); });",
              "pm.collectionVariables.set(\"sessionId\", d.sessionId);",
              "pm.collectionVariables.set(\"writerId\", d.writerId);",
              "pm.collectionVariables.set(\"writerEpoch\", String(d.writerEpoch));",
              "pm.collectionVariables.set(\"acceptedThroughSeq\", String(d.acceptedThroughSeq));",
              "pm.collectionVariables.set(\"appliedThroughSeq\", String(d.appliedThroughSeq));",
              "pm.collectionVariables.set(\"packageItems\", JSON.stringify(d.package.items));",
              "pm.collectionVariables.set(\"snapshot\", JSON.stringify(d.snapshot));",
              "pm.collectionVariables.unset(\"batchId\");",
              "pm.collectionVariables.unset(\"lastBatchId\");",
              "pm.collectionVariables.unset(\"takeoverRequestId\");",
              "pm.collectionVariables.unset(\"finishRequest\");"
            ]
          }
        }
      ]
    },
    {
      "name": "02 读取场次与题包",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/practice/sessions/{{sessionId}}",
        "description": "读取当前题包、写入设备、epoch、双水位与答案快照。"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.collectionVariables.set(\"writerId\", d.writerId);",
              "pm.collectionVariables.set(\"writerEpoch\", String(d.writerEpoch));",
              "pm.collectionVariables.set(\"acceptedThroughSeq\", String(d.acceptedThroughSeq));",
              "pm.collectionVariables.set(\"appliedThroughSeq\", String(d.appliedThroughSeq));",
              "pm.collectionVariables.set(\"packageItems\", JSON.stringify(d.package.items));",
              "pm.collectionVariables.set(\"snapshot\", JSON.stringify(d.snapshot));",
              "pm.test(\"包含固定版本题包与快照\", () => { pm.expect(d.package.items).to.have.length(20); pm.expect(d.snapshot).to.have.property(\"answers\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 上传答案批次",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/practice/sessions/{{sessionId}}/sync-batches",
        "description": "上传 PRACTICE 客观题确认。网络失败时保留相同 batchId 重发；HTTP 202 表示已持久接收，需另查应用水位。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"batchId\": \"{{batchId}}\",\n  \"writerId\": \"{{writerId}}\",\n  \"writerEpoch\": {{writerEpoch}},\n  \"firstSeq\": 1,\n  \"lastSeq\": 1,\n  \"changes\": [\n    {\n      \"seq\": 1,\n      \"type\": \"ANSWER_CONFIRM\",\n      \"itemId\": \"item-001\",\n      \"answer\": { \"optionKeys\": [\"opt_1\"] },\n      \"evaluation\": \"CORRECT\",\n      \"awardedScore\": \"1.00\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get(\"batchId\")) pm.collectionVariables.set(\"batchId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 202 Accepted\", () => pm.response.to.have.status(202));",
              "const d = pm.response.json();",
              "pm.test(\"批次有持久接收回执\", () => { pm.expect(d.receipt).to.eql(\"ACCEPTED\"); pm.expect(d.batchId).to.eql(pm.collectionVariables.get(\"batchId\")); });",
              "if (pm.response.code === 202) { pm.collectionVariables.set(\"lastBatchId\", pm.collectionVariables.get(\"batchId\")); pm.collectionVariables.unset(\"batchId\"); pm.collectionVariables.set(\"acceptedThroughSeq\", String(d.acceptedThroughSeq)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 重发同一答案批次（幂等）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/practice/sessions/{{sessionId}}/sync-batches",
        "description": "在第03步成功后可重发完全相同的 batchId 和内容，验证幂等回执。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"batchId\": \"{{lastBatchId}}\",\n  \"writerId\": \"{{writerId}}\",\n  \"writerEpoch\": 1,\n  \"firstSeq\": 1,\n  \"lastSeq\": 1,\n  \"changes\": [\n    {\n      \"seq\": 1,\n      \"type\": \"ANSWER_CONFIRM\",\n      \"itemId\": \"item-001\",\n      \"answer\": { \"optionKeys\": [\"opt_1\"] },\n      \"evaluation\": \"CORRECT\",\n      \"awardedScore\": \"1.00\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 202 Accepted\", () => pm.response.to.have.status(202));",
              "const d = pm.response.json();",
              "pm.test(\"重发返回同一批次回执\", () => { pm.expect(d.receipt).to.eql(\"ACCEPTED\"); pm.expect(d.batchId).to.eql(pm.collectionVariables.get(\"lastBatchId\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 查询同步水位",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/practice/sessions/{{sessionId}}/sync-status",
        "description": "重复发送本请求，直到 appliedThroughSeq 等于 acceptedThroughSeq，再继续换端或交卷。"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.collectionVariables.set(\"acceptedThroughSeq\", String(d.acceptedThroughSeq));",
              "pm.collectionVariables.set(\"appliedThroughSeq\", String(d.appliedThroughSeq));",
              "pm.test(\"返回接收和应用水位\", () => { pm.expect(d).to.have.property(\"acceptedThroughSeq\"); pm.expect(d).to.have.property(\"appliedThroughSeq\"); });",
              "console.info(`接收水位=${d.acceptedThroughSeq}, 应用水位=${d.appliedThroughSeq}`);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 换设备接管",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/practice/sessions/{{sessionId}}/takeover",
        "description": "固定接收屏障并转移写入权。出现 HANDOVER 时保持原 takeoverRequestId，等待一会后重发本请求。完成后自动更新 writerId / writerEpoch。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"{{takeoverRequestId}}\",\n  \"writerId\": \"{{nextWriterId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get(\"takeoverRequestId\")) pm.collectionVariables.set(\"takeoverRequestId\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.set(\"previousWriterEpoch\", pm.collectionVariables.get(\"writerEpoch\") || \"1\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"接管正在完成或已完成\", () => pm.expect([\"OPEN\", \"HANDOVER\"]).to.include(d.ingressState));",
              "if (d.ingressState === \"OPEN\" && Number(d.writerEpoch) > Number(pm.collectionVariables.get(\"previousWriterEpoch\"))) { pm.collectionVariables.set(\"writerId\", d.writerId); pm.collectionVariables.set(\"writerEpoch\", String(d.writerEpoch)); pm.collectionVariables.unset(\"takeoverRequestId\"); pm.collectionVariables.set(\"snapshot\", JSON.stringify(d.snapshot)); }",
              "else if (d.ingressState === \"HANDOVER\") console.info(\"接管屏障尚在排空；稍候后使用相同请求再次发送。\");"
            ]
          }
        }
      ]
    },
    {
      "name": "07 刷新场次快照",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/practice/sessions/{{sessionId}}",
        "description": "接管后读取新 writerEpoch 和最新快照；交卷前确认此快照包含已应用答案。"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.collectionVariables.set(\"writerId\", d.writerId);",
              "pm.collectionVariables.set(\"writerEpoch\", String(d.writerEpoch));",
              "pm.collectionVariables.set(\"acceptedThroughSeq\", String(d.acceptedThroughSeq));",
              "pm.collectionVariables.set(\"appliedThroughSeq\", String(d.appliedThroughSeq));",
              "pm.collectionVariables.set(\"packageItems\", JSON.stringify(d.package.items));",
              "pm.collectionVariables.set(\"snapshot\", JSON.stringify(d.snapshot));",
              "pm.test(\"接收与应用水位已追平\", () => pm.expect(Number(d.appliedThroughSeq)).to.eql(Number(d.acceptedThroughSeq)));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 提交完成结果",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/practice/sessions/{{sessionId}}/finish",
        "description": "根据最新云端快照生成与之相符的20题 CLIENT_REPORTED 结果。请先刷新水位并在 05 步确认已追平，再刷新场次快照。网络失败重试时复用同一 finishRequest。",
        "body": {
          "mode": "raw",
          "raw": "{{finishRequest}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get(\"finishRequest\")) {",
              "  const items = JSON.parse(pm.collectionVariables.get(\"packageItems\") || \"[]\");",
              "  const snapshot = JSON.parse(pm.collectionVariables.get(\"snapshot\") || \"{}\");",
              "  const answers = snapshot.answers || {};",
              "  const rows = items.map(item => {",
              "    const a = answers[item.itemId];",
              "    return a ? { itemId: item.itemId, answer: a.answer, evaluation: a.evaluation, awardedScore: a.awardedScore } : { itemId: item.itemId, answer: null, evaluation: \"UNANSWERED\", awardedScore: \"0.00\" };",
              "  });",
              "  const count = value => rows.filter(item => item.evaluation === value).length;",
              "  const score = rows.reduce((sum, item) => sum + Number(item.awardedScore), 0).toFixed(2);",
              "  const maxScore = items.reduce((sum, item) => sum + Number(item.maxScore), 0).toFixed(2);",
              "  const body = {",
              "    requestId: pm.variables.replaceIn(\"{{$guid}}\"),",
              "    writerId: pm.collectionVariables.get(\"writerId\"),",
              "    writerEpoch: Number(pm.collectionVariables.get(\"writerEpoch\")),",
              "    finalSeq: Number(pm.collectionVariables.get(\"acceptedThroughSeq\") || \"0\"),",
              "    result: { completedAt: new Date().toISOString(), items: rows, summary: { total: rows.length, answered: count(\"CORRECT\") + count(\"WRONG\"), correct: count(\"CORRECT\"), wrong: count(\"WRONG\"), unanswered: count(\"UNANSWERED\"), score, maxScore } }",
              "  };",
              "  pm.collectionVariables.set(\"finishRequest\", JSON.stringify(body));",
              "}",
              "console.info(\"交卷体已固定；相同请求重试会复用同一 requestId 与负载。\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"完成请求状态可识别\", () => pm.expect([\"FINISHING\", \"COMPLETED\", \"FINISH_REJECTED\"]).to.include(d.status));",
              "console.info(`当前结果状态=${d.status}`);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 查询最终结果",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/practice/sessions/{{sessionId}}/result",
        "description": "重复查询，直到 status=COMPLETED；检查 source=CLIENT_REPORTED。"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"结果来源为客户端判定\", () => pm.expect(d.source).to.eql(\"CLIENT_REPORTED\"));",
              "pm.test(\"状态可识别\", () => pm.expect([\"OPEN\", \"FINISHING\", \"COMPLETED\", \"FINISH_REJECTED\"]).to.include(d.status));",
              "if (d.status === \"COMPLETED\") pm.test(\"完成结果含逐题记录\", () => pm.expect(d.result.items).to.have.length(20));"
            ]
          }
        }
      ]
    }
  ]
}
