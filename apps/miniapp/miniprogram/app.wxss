page,
.portal-theme {
  --brand: #2b7ffc;
  --brand-dark: #1a63d8;
  --brand-soft: #e8f1ff;
  --text-main: #1f2a37;
  --text-sub: #6b7684;
  --text-muted: #9aa4b2;
  --line: #eceff4;
  --card: #ffffff;
  --page-bg: #ffffff;
  --success: #17b26a;
  --danger: #f04438;
  --warning: #f79009;
}

page {
  background: var(--page-bg);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
scroll-view {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 42, 55, 0.06);
}

.text-sub {
  color: var(--text-sub);
}

.text-muted {
  color: var(--text-muted);
}

.section-title {
  margin: 0 0 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.empty-block {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-muted);
}

/* 按压反馈：列表轻微变色，按钮与图标轻微变淡；持续选中状态由各控件独立表达。 */
.btn,
button {
  transition: background-color 100ms ease, opacity 100ms ease;
}

.row-hover {
  background-color: rgba(31, 42, 55, 0.04);
}

.card-hover,
.btn-hover,
.btn-flat-hover,
.chip-hover,
.chip-flat-hover {
  opacity: 0.86;
}

.ghost-hover,
.ghost-flat-hover {
  opacity: 0.72;
}

/* ===== 入场动画 =====
   列表类内容整段位移比逐项位移更稳，配合 .stagger 做错峰，避免"整屏内容啪一下出现"。 */
@keyframes qanda-fade-up {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes qanda-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes qanda-pop-in {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 首屏直接呈现；局部弹层和答题反馈保留各自的动画。 */
.anim-pop-in {
  animation: qanda-pop-in 160ms ease-out both;
}

.load-note {
  padding: 20rpx 24rpx;
  color: #66758c;
  font-size: 24rpx;
  text-align: center;
}

/* === ICON-BLOCK-START：由 scripts/generate-menu-icons.cjs 生成，勿手工编辑 === */
/* 图标本体：24×24 描边网格，图形 40rpx，容器 68rpx 作为可点圆角方块 */
.mi-icon {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.mi-tile {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

