<view
  class="chapter-row {{bank.isComplete ? 'is-done' : ''}}"
  bindtap="handleOpenTap"
  hover-class="chapter-hover"
  hover-start-time="0"
  hover-stay-time="80"
>
  <view class="chapter-body">
    <text class="chapter-title">{{bank.title}}</text>
  </view>

  <text class="chapter-meta">{{bank.metaText}}</text>
  <text class="chapter-arrow">›</text>
</view>
