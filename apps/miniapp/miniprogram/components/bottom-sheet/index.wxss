.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
}

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: sheet-rise 0.22s ease-out;
}

@keyframes sheet-rise {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

.panel-center {
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  bottom: auto;
  transform: translateY(-50%);
  border-radius: 32rpx;
  padding-bottom: 0;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 36, 0.24);
  animation: modal-pop 0.2s ease-out;
}

@keyframes modal-pop {
  from {
    opacity: 0;
    transform: translateY(-50%) scale(0.92);
  }

  to {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }
}

/* 居中弹窗里的头部：去掉底部分隔线，改成更轻的分组 */
.panel-center .panel-header {
  padding: 30rpx 32rpx 8rpx;
  border-bottom: none;
}

.panel-center .panel-body {
  padding: 0 32rpx 32rpx;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a37;
}

.panel-close {
  font-size: 26rpx;
  color: #8490a3;
}

.panel-body {
  max-height: 62vh;
  padding: 24rpx 32rpx 32rpx;
}
