.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
}

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: sheet-rise 0.22s ease-out;
}

@keyframes sheet-rise {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.panel-close {
  font-size: 26rpx;
  color: var(--text-muted);
}

.panel-body {
  max-height: 62vh;
  padding: 24rpx 32rpx 32rpx;
}
