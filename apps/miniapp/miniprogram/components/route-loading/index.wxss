.route-loading {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-card {
  width: 400rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--brand-soft);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: route-loading-spin 0.8s linear infinite;
}

@keyframes route-loading-spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-title {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

.loading-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
}
