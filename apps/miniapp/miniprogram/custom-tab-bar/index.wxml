<!-- 自定义 tabBar：胶囊悬浮 + 中央「继续答题」圆钮。
     结构上把中央按钮单独拿出来定位，避免它挤在四个 tab 之间把间距压变形 -->
<!-- hidden：页面里有弹层时由页面调用 setHidden(true) 收起。
     自定义 tabBar 是独立图层，永远盖在页面之上，弹层躲不开它，
     所以打开弹层时干脆把整条底栏藏掉。 -->
<view class="tabbar-wrap {{hidden ? 'tabbar-hidden' : ''}}">
  <view class="tabbar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="handleTabTap"
      hover-class="tab-item-hover"
      hover-start-time="0"
      hover-stay-time="240"
    >
      <image class="tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit"></image>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>

  <!-- 中央圆钮：只放播放三角，不再塞文字 —— 文字放下面白色胶囊里，
       一是圆钮能变小一点不压顶，二是文字和左右四个 tab 的标签齐平。
       两者各自可点，都走 handleContinueTap。 -->
  <view
    class="continue-btn"
    bindtap="handleContinueTap"
    hover-class="continue-hover"
    hover-start-time="0"
    hover-stay-time="240"
  >
    <view class="continue-icon"></view>
  </view>

  <text
    class="continue-label"
    bindtap="handleContinueTap"
    hover-class="continue-label-hover"
    hover-start-time="0"
    hover-stay-time="240"
  >继续答题</text>
</view>
