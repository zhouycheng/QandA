/**
 * 自定义 tabBar 尺寸（2026-10-25 真机反馈后放大并抬高）：
 *   胶囊高 120rpx，中央圆钮 118rpx，整体占位 232rpx。
 *
 *   真机反馈三件事：
 *     1. 「不太醒目」→ 胶囊 108→120，图标 44→50，标签 19→21；
 *     2. 「位置太低了」→ 胶囊离底 20→40rpx，并且整条底栏要躲开 iPhone 的
 *        Home 指示条（截图里那条黑杠），靠 env(safe-area-inset-bottom) 上移；
 *     3. 「太高了，往下走一点」→ 整条下移 24rpx（胶囊 40→16、圆钮 102→78、
 *        标签 58→34）。⚠️ 三者必须一起减：只改胶囊会让圆钮和「继续答题」
 *        跟胶囊脱节，圆钮反而悬在胶囊外面。
 *
 *   ⚠️ 四页的底部留白都按 272rpx 预留，改这里的尺寸要同步改
 *      page/{stats,my}/index.wxss、page/bank-detail/index.wxss、首页 .sheet。
 *      tests/custom-tabbar.check.js 会比对。
 */

/* 整条底栏浮在安全区之上：下方写 0 兜底，不支持 env() 的机型退回贴底 */
.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  bottom: env(safe-area-inset-bottom);
  height: 232rpx;
  pointer-events: none;
}

/* 弹层打开时整条底栏让位。用 display:none 而不是 opacity:0 ——
   后者虽然看不见但仍在最上层，会把弹层下方的按钮点击全吃掉。 */

.tabbar {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 16rpx;
  /* 左右各留 24rpx：首尾图标不贴胶囊边缘，四个 tab 与中央圆钮的距离才是对称的 */
  padding: 0 24rpx;
  box-sizing: border-box;
  height: 120rpx;
  display: flex;
  align-items: center;
  border-radius: 60rpx;
  /* 毛玻璃：半透明白 + 背景模糊。
     不支持的机型会退化成「半透明白条」，仍然比纯白实心透气，
     所以底色保留透明度而不是写死 #fff。 */
  /* saturate 是关键：只加模糊会让底下的内容整体发灰，
     提高饱和度才像 iOS 那种「透亮」的玻璃。
     白色底的 0.76 是折中值：再透一点（0.7）时深色卡片滚到底栏下面，
     #8a94a6 的未选中文字会糊在背景里认不出。 */
  background: rgba(252, 253, 255, 0.76);
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 28rpx rgba(31, 42, 55, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  pointer-events: auto;
}

/* 四个 tab 均分「胶囊宽度 - 中间让位」，左右各两个 */
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  transition: opacity 100ms ease;
}

/**
 * 中央按钮的让位边距加在**第 2 个 tab 之后**，不是第 3 个之后。
 *
 * 加在第 3 个之后（margin-right）时，前 3 个 tab 平分左半侧，
 * 第 3 个（复盘）刚好被推到屏幕正中，整个压在圆钮底下 —— 用户看到的就是
 * 「复盘隐藏在继续答题的下方」。
 * 加在第 2 个之后，才是「首页/题库 | 空档 | 复盘/我的」左右各二。
 *
 * 数值（含 .tabbar 的 padding: 0 24rpx）：
 *   胶囊内宽 = 686 - 24×2 = 638rpx，让位 140rpx → 每格 (638-140)/4 = 124.5rpx
 *   tab 依次占 [56,180.5] [180.5,305] …空档… [445,569.5] [569.5,694]
 *   距胶囊左右内边缘都是 24rpx，四个图标的中心到屏幕中线距离完全相等 → 对称
 */
.tab-item:nth-child(2) {
  margin-right: 140rpx;
}

.tab-item-hover {
  opacity: 0.72;
}

/* 四个图标同一个盒子、同一描边，避免「有的显大有的显小」 */
.tab-icon {
  width: 50rpx;
  height: 50rpx;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8a94a6;
}

.tab-item.active .tab-text {
  color: #2b7ffc;
  font-weight: 600;
}

.continue-btn {
  position: absolute;
  left: 50%;
  bottom: 78rpx;
  width: 118rpx;
  height: 118rpx;
  margin-left: -59rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f7dfb 0%, #2b7ffc 100%);
  box-shadow: 0 10rpx 26rpx rgba(43, 127, 252, 0.4);
  pointer-events: auto;
  transition: opacity 100ms ease;
}

.continue-hover {
  opacity: 0.86;
}

.continue-icon {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-style: solid;
  border-width: 20rpx 0 20rpx 32rpx;
  border-color: transparent transparent transparent #ffffff;
}

/**
 * ⚠️ 「继续答题」这四个字**绝不能 left:0 + right:0 铺满整条底栏**。
 *
 * 它和四个 tab 的标签在同一高度（bottom 34rpx、高 30rpx），一旦铺满，
 * 这一条横向 30rpx 的带子就压在所有 tab 文字上方，并且因为它是绝对定位、
 * 在 DOM 里又排在 tab 之后，命中检测全部落到它身上 ——
 * 用户点「统计」两个字，实际触发的是 handleContinueTap，页面直接跳去答题。
 * 所以宽度只给中央圆钮那一格（130rpx），左右都不越界。
 */
.continue-label {
  position: absolute;
  left: 50%;
  width: 130rpx;
  margin-left: -65rpx;
  bottom: 34rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 600;
  color: #2b7ffc;
  pointer-events: auto;
}

.continue-label-hover {
  opacity: 0.72;
}
