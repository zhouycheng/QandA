<view class="bank-detail-page">
  <!-- 页内标题 + 搜索 + 筛选（系统导航标题留空，见 index.json） -->
  <view class="bk-head">
    <text class="bk-title">题库</text>
    <view class="bk-tools">
      <view class="bk-search">
        <view class="bk-search-icon"></view>
        <input
          class="bk-search-input"
          value="{{searchKeyword}}"
          placeholder="搜索题库 / 章节"
          placeholder-class="bk-search-ph"
          confirm-type="search"
          maxlength="20"
          bindinput="handleSearchInput"
          bindconfirm="handleSearchConfirm"
        />
        <view
          class="bk-search-clear"
          wx:if="{{searchKeyword}}"
          bindtap="handleSearchClear"
          hover-class="bk-icon-hover"
          hover-start-time="0"
          hover-stay-time="160"
        >×</view>
      </view>
      <view
        class="bk-filter {{filterUnfinished ? 'is-on' : ''}} {{filterEnabled ? '' : 'is-off'}}"
        bindtap="handleFilterToggle"
        hover-class="bk-icon-hover"
        hover-start-time="0"
        hover-stay-time="160"
      >
        <view class="bk-filter-icon"></view>
      </view>
    </view>
  </view>

  <view class="workbench" wx:if="{{subject}}">
    <scroll-view class="rail" scroll-y enhanced bounces show-scrollbar="{{false}}">
      <view class="rail-inner">
        <view
          class="rail-item {{railMode === 'recent' ? 'is-active' : ''}}"
          bindtap="handleRecentTap"
          hover-class="rail-item-hover"
          hover-start-time="0"
          hover-stay-time="200"
        >
          <view class="rail-bar"></view>
          <view class="rail-body">
            <text class="rail-name">最近在刷</text>
          </view>
        </view>

        <view class="rail-divider"></view>

        <view
          wx:for="{{subjects}}"
          wx:key="id"
          class="rail-item {{item.active ? 'is-active' : ''}}"
          data-subject-id="{{item.id}}"
          bindtap="handleSubjectSwitch"
          hover-class="rail-item-hover"
          hover-start-time="0"
          hover-stay-time="200"
        >
          <view class="rail-bar"></view>
          <view class="rail-body">
            <text class="rail-name">{{item.name}}</text>
          </view>
        </view>

      </view>
    </scroll-view>

    <scroll-view class="panel" scroll-y enhanced bounces show-scrollbar="{{false}}">
      <view class="panel-inner">
        <!-- 搜索态：跨科目命中，点一行直接配这一章 -->
        <block wx:if="{{searchActive}}">
          <view class="search-head">
            <text class="search-title">搜索结果</text>
            <text class="search-sub">{{searchResults.length}} 条</text>
          </view>

          <view
            wx:for="{{searchResults}}"
            wx:key="bankId"
            class="search-row"
            data-bank-id="{{item.bankId}}"
            data-subject-id="{{item.subjectId}}"
            bindtap="handleSearchResultTap"
            hover-class="search-row-hover"
            hover-start-time="0"
            hover-stay-time="200"
          >
            <view class="search-row-main">
              <text class="search-row-title">{{item.chapterTitle}}</text>
              <text class="search-row-sub">{{item.subjectName}} · {{item.metaText}}</text>
            </view>
            <text class="search-row-arrow">›</text>
          </view>

          <view class="empty-block" wx:if="{{searchEmptyText}}">
            <text>{{searchEmptyText}}</text>
          </view>
        </block>

        <block wx:else>
          <view
            class="stat-card"
            bindtap="handleStatTap"
            hover-class="stat-card-hover"
            hover-start-time="0"
            hover-stay-time="200"
          >
            <view class="stat-top">
              <text class="stat-scope">{{railMode === 'recent' ? '最近在刷 · ' : ''}}{{subject.name}}</text>
              <text class="stat-more">整科 ›</text>
            </view>
            <view class="stat-row" wx:if="{{stats}}">
              <view class="stat-item">
                <text class="stat-value">{{stats.total}}</text>
                <text class="stat-label">题目总数</text>
              </view>
              <view class="stat-line"></view>
              <view class="stat-item">
                <text class="stat-value">{{stats.answered}}</text>
                <text class="stat-label">已答题数</text>
              </view>
              <view class="stat-line"></view>
              <view class="stat-item">
                <text class="stat-value">{{stats.accuracyText}}</text>
                <text class="stat-label">正确率</text>
              </view>
            </view>
          </view>

          <view class="chapter-list">
            <bank-list-item
              wx:for="{{rows}}"
              wx:key="bankId"
              bank="{{item}}"
              bind:open="handleBankOpen"
            />
          </view>

          <view class="empty-block" wx:if="{{!rows.length}}">
            <text>{{listEmptyText}}</text>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- 答题配置抽屉：参数都是「本次答题」的，不写学习偏好 -->
  <view class="config-sheet" wx:if="{{configSheetVisible}}">
    <view class="config-mask" bindtap="handleSheetClose"></view>
    <view class="config-panel">
      <view class="config-grip"></view>

      <view class="config-head">
        <text class="config-title">{{configTitle}}</text>
        <text class="config-sub">{{configSubtitle}}</text>
      </view>

      <view class="config-rows">
        <view class="config-row">
          <text class="config-label">模式</text>
          <view class="seg-group">
            <view
              wx:for="{{modeOptions}}"
              wx:key="value"
              class="seg-chip {{sheetMode === item.value ? 'is-active' : ''}}"
              data-value="{{item.value}}"
              bindtap="handleSheetMode"
              hover-class="chip-flat-hover"
              hover-start-time="0"
              hover-stay-time="160"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="config-row">
          <text class="config-label">顺序</text>
          <view class="seg-group">
            <view
              wx:for="{{orderOptions}}"
              wx:key="value"
              class="seg-chip {{sheetOrder === item.value ? 'is-active' : ''}} {{sheetOrderDisabled ? 'is-muted' : ''}}"
              data-value="{{item.value}}"
              bindtap="handleSheetOrder"
              hover-class="chip-flat-hover"
              hover-start-time="0"
              hover-stay-time="160"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="config-row">
          <text class="config-label">是否限时</text>
          <switch
            class="config-switch"
            checked="{{sheetTimed}}"
            color="#466BFF"
            bindchange="handleSheetTimed"
          />
        </view>

        <view class="config-row config-row-chips" wx:if="{{sheetTimed}}">
          <view class="seg-group seg-group-end">
            <view
              wx:for="{{durationOptions}}"
              wx:key="value"
              class="seg-chip {{sheetDuration === item.value ? 'is-active' : ''}}"
              data-value="{{item.value}}"
              bindtap="handleSheetDuration"
              hover-class="chip-flat-hover"
              hover-start-time="0"
              hover-stay-time="160"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="config-row">
          <text class="config-label">只答错题</text>
          <view class="config-row-tail">
            <text class="config-inline-hint" wx:if="{{!sheetWrongCount}}">暂无错题</text>
            <switch
              class="config-switch"
              checked="{{sheetOnlyWrong}}"
              color="#466BFF"
              bindchange="handleSheetOnlyWrong"
            />
          </view>
        </view>
      </view>

      <view class="config-actions">
        <view
          class="config-btn ghost"
          bindtap="handleSheetClose"
          hover-class="btn-flat-hover"
          hover-start-time="0"
          hover-stay-time="200"
        >取消</view>
        <view
          class="config-btn primary"
          bindtap="handleConfigConfirm"
          hover-class="btn-flat-hover"
          hover-start-time="0"
          hover-stay-time="200"
        >{{sheetStartText}}</view>
      </view>
    </view>
  </view>

  <route-loading
    visible="{{routeLoadingVisible}}"
    title="{{routeLoadingTitle}}"
    description="{{routeLoadingDescription}}"
  />
</view>
