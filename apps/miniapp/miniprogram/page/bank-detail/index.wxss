/* 两栏背景铺满视口；滚动内容末尾为悬浮底栏留出可滚动空间。 */
page { background: #fff; }
.bk-navigation { display: flex; align-items: center; padding-right: 210rpx; }
.bank-detail-page {
  box-sizing: border-box;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
}

/* ---------- 页内标题 + 搜索 + 筛选 ---------- */
.bk-head {
  flex: none;
  padding: 0 26rpx 20rpx;
  background: #ffffff;
}

.bk-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #141820;
  letter-spacing: 1rpx;
}

.bk-tools {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}

.bk-search {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: #f3f4f6;
}

.bk-search-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  /* 图标 base64 内联：微信不支持本地 .svg 的 background-image（见 AGENTS.md） */
  background-image: url("data:image/svg+xml;base64,");
}

.bk-search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  margin-left: 14rpx;
  font-size: 26rpx;
  color: #141820;
}

.bk-search-ph {
  font-size: 26rpx;
  color: #a0a5af;
}

.bk-search-clear {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 34rpx;
  color: #8b8f99;
}

.bk-filter {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3f4f6;
  transition: background-color 120ms ease;
}

.bk-filter-icon {
  width: 30rpx;
  height: 30rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlLXdpZHRoPSIxLjgiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBhdGggZD0iTTQuMiA1LjZoMTUuNmwtNi4xIDYuOXY1LjRsLTMuNCAxLjd2LTcuMXoiIHN0cm9rZT0iIzhCOEY5OSIvPjwvc3ZnPg==");
}

.bk-filter.is-on {
  background: var(--brand);
}

.bk-filter.is-on .bk-filter-icon {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlLXdpZHRoPSIxLjgiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBhdGggZD0iTTQuMiA1LjZoMTUuNmwtNi4xIDYuOXY1LjRsLTMuNCAxLjd2LTcuMXoiIHN0cm9rZT0iI0ZGRkZGRiIvPjwvc3ZnPg==");
}

/* 一个章节都没有时筛选无从谈起，按钮压淡但依然可点（点了会给出空态提示） */
.bk-filter.is-off {
  opacity: 0.45;
}

/* 只有 icon 的圆形按钮：按压只压透明度，避免整块位移 */
.bk-icon-hover {
  opacity: 0.72;
}

/* ---------- 左栏 + 右栏 ---------- */
.workbench {
  height: 100%;
  flex: 1;
  min-height: 0;
  display: flex;
}

.rail {
  flex: none;
  width: 176rpx;
  height: 100%;
  background: #f5f6f8;
}

.rail-inner {
  padding: 12rpx 0 272rpx;
  padding-bottom: calc(272rpx + env(safe-area-inset-bottom));
}

.rail-item {
  display: flex;
  align-items: stretch;
  min-height: 92rpx;
  padding-right: 10rpx;
}

.rail-bar {
  flex: none;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: transparent;
}

.rail-body {
  flex: 1;
  min-width: 0;
  padding-left: 18rpx;
  display: flex;
  align-items: center;
}

.rail-name {
  font-size: 26rpx;
  line-height: 1.3;
  color: #4a4f5a;
}

.rail-count {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #a0a5af;
}

/* 选中项与右侧面板同色，视觉上「贴着」面板，这是侧边标签页的常见做法 */
.rail-item.is-active {
  background: #ffffff;
}

.rail-item.is-active .rail-bar {
  background: var(--brand);
}

.rail-item.is-active .rail-name {
  font-weight: 600;
  color: #141820;
}

.rail-divider {
  height: 24rpx;
}

.rail-tool .rail-name {
  color: var(--brand);
}

.rail-item-hover {
  background: rgba(31, 42, 55, 0.04);
}

.panel {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: #ffffff;
}

.panel-inner {
  padding: 24rpx 24rpx 272rpx;
  padding-bottom: calc(272rpx + env(safe-area-inset-bottom));
}

/* ---------- 统计卡 ---------- */
.stat-card {
  padding: 22rpx 20rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #5c7cff 0%, #3d5bf5 100%);
  box-shadow: 0 12rpx 30rpx rgba(70, 107, 255, 0.28);
  transition: opacity 100ms ease;
}

/* 卡片在 scroll-view 里：按压只改透明度 */
.stat-card-hover {
  opacity: 0.86;
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
}

.stat-scope {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
}

.stat-more {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.stat-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #ffffff;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.72);
}

.stat-line {
  flex: none;
  width: 1rpx;
  height: 46rpx;
  background: rgba(255, 255, 255, 0.26);
}

/* ---------- 章节列表 ---------- */
.chapter-list {
  margin-top: 22rpx;
}

/* ---------- 搜索面板 ---------- */
.search-head {
  padding: 4rpx 4rpx 18rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.search-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #141820;
}

.search-sub {
  font-size: 22rpx;
  color: #8b8f99;
}

.search-row {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  background: #f5f6f8;
  transition: opacity 100ms ease;
}

.search-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.search-row-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #141820;
}

.search-row-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b8f99;
}

.search-row-arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #b4b9c2;
}

.search-row-hover {
  opacity: 0.86;
}

.empty-block {
  padding: 72rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #a0a5af;
}

/* ---------- 答题配置抽屉 ---------- */
.config-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
}

.config-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
}

.config-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  animation: config-rise 0.22s ease-out;
}

@keyframes config-rise {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

.config-grip {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  background: #e2e5ea;
}

.config-head {
  padding: 22rpx 4rpx 6rpx;
}

.config-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #141820;
}

.config-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8b8f99;
}

.config-rows {
  margin-top: 10rpx;
}

.config-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.config-label {
  font-size: 27rpx;
  color: #141820;
}

.config-row-chips {
  min-height: 76rpx;
}

.config-row-tail {
  display: flex;
  align-items: center;
}

.config-inline-hint {
  margin-right: 10rpx;
  font-size: 21rpx;
  color: #a0a5af;
}

/* 原生开关按设计稿压小一档；只影响自身，不参与 hover 反馈 */
.config-switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.seg-group {
  display: flex;
  align-items: center;
}

.seg-group-end {
  margin-left: auto;
}

.seg-chip {
  height: 56rpx;
  margin-left: 12rpx;
  padding: 0 24rpx;
  line-height: 56rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #4a4f5a;
  background: #f3f4f6;
  transition: background-color 100ms ease, color 100ms ease;
}

.seg-chip.is-active {
  font-weight: 600;
  color: #ffffff;
  background: var(--brand);
}

.seg-chip.is-muted {
  opacity: 0.4;
}

.config-actions {
  margin-top: 26rpx;
  display: flex;
}

.config-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 29rpx;
}

.config-btn.ghost {
  margin-right: 20rpx;
  color: #4a4f5a;
  background: #f0f1f4;
}

.config-btn.primary {
  font-weight: 600;
  color: #ffffff;
  background: var(--brand);
}
