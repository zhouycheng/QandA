<view class="page settings-page">
  <view class="menu card">
    <view class="exam-row"><text class="exam-label">考试名称</text><input class="exam-input" value="{{examDraftName}}" maxlength="20" placeholder="如：期末考试 / 考研" bindblur="handleExamNameBlur" /></view>
    <picker class="exam-row" mode="date" value="{{exam.examDate}}" bindchange="handleExamDateChange"><text class="exam-label">考试日期</text><text class="exam-value">{{exam.examDate || '请选择日期'}} ›</text></picker>
    <view class="exam-status"><text>{{exam.configured ? exam.examName + ' · ' + exam.dayText + exam.statusText : '填写名称和日期后，首页会显示考试倒计时'}}</text></view>
  </view>
  <view class="section-reset" bindtap="handleClearExam" hover-class="ghost-flat-hover" hover-start-time="0" hover-stay-time="80">清除倒计时</view>
</view>
