@import "../../styles/auth-form.wxss";

/**
 * 登录页专属差异｜设计稿 763:567
 * 公共尺寸在 styles/auth-form.wxss，这里只写这张画板不同的行距。
 */

/* 画板里「登录」标题到邮箱标签是 45px（84rpx），比注册页多 5px */
.login-form {
  margin-top: 84rpx;
}

/* 两个字段之间 24px（45rpx）：比注册页的 12px 松，是这张画板的节奏 */
.login-form .field + .field {
  margin-top: 45rpx;
}

/* 协议行到主按钮 30px（56rpx） */
.login-submit {
  margin-top: 56rpx;
}

/* 「或」到微信登录按钮 8px（15rpx） */
.wechat-btn {
  margin-top: 15rpx;
}
