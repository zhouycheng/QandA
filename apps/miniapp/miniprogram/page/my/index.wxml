<!-- 我的｜设计稿 Figma 781:1922（画板 402x874，系数 750/402 ≈ 1.8657）
     页内大标题 + 资料头 + 账号管理 + 学习设置 + 法律协议。 -->
<view class="list-page" style="padding-top: {{homeStatusBarHeight}}px;">
  <view class="page-head" style="height: {{homeNavigationBarHeight}}px; padding-right: 210rpx;">
    <text class="page-head-title">我的</text>
  </view>

  <!-- 资料头：未登录点它去登录，已登录进账号管理 -->
  <view
    class="profile"
    bindtap="handleProfileTap"
    hover-class="profile-hover"
    hover-start-time="0"
    hover-stay-time="80"
  >
    <view class="profile-avatar">
      <image class="profile-avatar-img" src="{{auth.avatarUrl}}" mode="aspectFill" wx:if="{{auth.avatarUrl}}"></image>
      <view class="avatar-icon" wx:else></view>
    </view>
    <view class="profile-main">
      <text class="profile-name">{{auth.displayName}}</text>
      <text class="profile-sub" wx:if="{{auth.loggedIn}}">{{auth.subText}}</text>
      <text class="profile-sub" wx:else>{{auth.accountTag}}</text>
      <text class="profile-meta">{{auth.metaText}}</text>
    </view>
  </view>

  <view
    class="pill-row"
    bindtap="handleAccountTap"
    hover-class="pill-row-hover"
    hover-start-time="0"
    hover-stay-time="80"
  >
    <text class="pill-row-label">账号管理</text>
    <text class="pill-row-value">个人信息与安全</text>
    <view class="chevron"></view>
  </view>

  <view class="group">
    <text class="group-title">学习设置</text>
    <view
      class="row"
      wx:for="{{learnRows}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="handleRowTap"
      hover-class="row-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <text class="row-label">{{item.title}}</text>
      <text class="row-value">{{item.value}}</text>
      <view class="chevron"></view>
    </view>
  </view>

  <view
    wx:if="{{auth.loggedIn}}"
    class="bottom-btn logout-button"
    bindtap="confirmLogout"
    hover-class="bottom-btn-hover"
    hover-start-time="0"
    hover-stay-time="80"
    aria-role="button"
  >退出登录</view>

  <view class="links">
    <text
      class="link"
      data-key="agreement"
      bindtap="handleRowTap"
      hover-class="link-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >用户协议</text>
    <view class="link-divider"></view>
    <text
      class="link"
      data-key="privacy"
      bindtap="handleRowTap"
      hover-class="link-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >隐私政策</text>
  </view>
</view>

<!-- 关于和协议共用居中弹窗。 -->
<bottom-sheet
  visible="{{sheet !== ''}}"
  title="{{sheetTitle}}"
  placement="center"
  bind:close="handleSheetClose"
>
  <view wx:if="{{sheet === 'about'}}">
    <view class="about-line">
      <text class="about-label">版本</text>
      <text class="about-value" bindtap="handleVersionTap" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{about.version || '—'}}</text>
    </view>
    <view class="about-line">
      <text class="about-label">题库题量</text>
      <text class="about-value">{{about.questionCount}} 题</text>
    </view>
    <view class="about-line">
      <text class="about-label">题库覆盖</text>
      <text class="about-value">{{about.subjectCount}} 个科目 · {{about.bankCount}} 个题库</text>
    </view>
    <view class="about-line">
      <text class="about-label">技术形态</text>
      <text class="about-value">微信原生小程序</text>
    </view>
    <view
      class="about-line"
      wx:if="{{about.playgroundEnabled}}"
      bindtap="handlePlaygroundTap"
      hover-class="row-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <text class="about-label">开发者 Playground</text>
      <view class="chevron"></view>
    </view>
  </view>
  <text class="sheet-text" wx:else>{{sheetBody}}</text>

  <view class="sheet-actions">
    <view
      class="bottom-btn"
      bindtap="handleSheetClose"
      hover-class="bottom-btn-hover"
      hover-start-time="0"
      hover-stay-time="80"
    >知道了</view>
  </view>
</bottom-sheet>
