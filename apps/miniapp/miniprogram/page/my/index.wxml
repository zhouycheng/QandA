<view class="page my-page stagger">
  <view
    class="profile anim-fade-up"
    bindtap="handleOpenLogin"
    hover-class="card-hover"
    hover-start-time="0"
    hover-stay-time="240"
  >
    <view class="profile-avatar">
      <image class="profile-avatar-img" src="{{auth.avatarUrl}}" mode="aspectFill" wx:if="{{auth.avatarUrl}}"></image>
      <view class="mi-icon mi-user" wx:else></view>
    </view>
    <view class="profile-main">
      <text class="profile-name">{{auth.displayName}}</text>
      <text class="profile-sub">{{auth.loggedIn ? '微信登录 · 数据仅存本机' : '点击登录 · 数据仅存本机'}}</text>
    </view>
    <view class="profile-badge">{{version}}</view>
  </view>

  <view class="snapshot card anim-fade-up">
    <view class="snapshot-item">
      <text class="snapshot-value">{{questionCount}}</text>
      <text class="snapshot-label">题库题目</text>
    </view>
    <view class="snapshot-divider"></view>
    <view class="snapshot-item">
      <text class="snapshot-value value-danger">{{wrongCount}}</text>
      <text class="snapshot-label">待复习错题</text>
    </view>
    <view class="snapshot-divider"></view>
    <view class="snapshot-item">
      <text class="snapshot-value value-warning">{{favoriteCount}}</text>
      <text class="snapshot-label">我的收藏</text>
    </view>
  </view>

  <view class="section anim-fade-up">
    <text class="section-title">设置</text>

    <view class="menu card">
      <view class="menu-row" data-focus="practice" bindtap="handleOpenSettings" hover-class="row-hover" hover-start-time="0" hover-stay-time="200">
        <view class="mi-tile mi-tile-switch">
          <view class="mi-icon mi-switch"></view>
        </view>
        <view class="menu-main">
          <text class="menu-title">学习偏好</text>
          <text class="menu-desc">解析展示、自动翻页、答题卡与字号</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-row" data-focus="account" bindtap="handleOpenSettings" hover-class="row-hover" hover-start-time="0" hover-stay-time="200">
        <view class="mi-tile mi-tile-shield">
          <view class="mi-icon mi-shield"></view>
        </view>
        <view class="menu-main">
          <text class="menu-title">账户与安全</text>
          <text class="menu-desc">修改密码、更换邮箱与登录状态</text>
        </view>
        <text class="menu-tag">{{auth.accountTag}}</text>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-row" bindtap="handleClearRecords" hover-class="row-hover" hover-start-time="0" hover-stay-time="200">
        <view class="mi-tile mi-tile-trash">
          <view class="mi-icon mi-trash"></view>
        </view>
        <view class="menu-main">
          <text class="menu-title">清空学习数据</text>
          <text class="menu-desc">进度、错题、收藏、时长一并清除</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section anim-fade-up">
    <text class="section-title">关于</text>

    <view class="menu card">
      <view class="menu-row" data-focus="about" bindtap="handleOpenSettings" hover-class="row-hover" hover-start-time="0" hover-stay-time="200">
        <view class="mi-tile mi-tile-info">
          <view class="mi-icon mi-info"></view>
        </view>
        <view class="menu-main">
          <text class="menu-title">QandA 刷题</text>
          <text class="menu-desc">版本信息与题库规模</text>
        </view>
        <text class="menu-value">{{version}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="footer-note">
      <text>练习进度与错题都保存在本机，不上传服务端</text>
    </view>
  </view>
</view>
