/**
 * 答题页样式（按 2026-10-27 设计稿重做）
 *
 * 6 个面板共用同一套骨架：
 *   页内标题（返回 + 题库名 + 副标题）→ 细进度条 → 信息行 → 题目/选项 → 底部工具行 + 两按钮
 *
 * 换算：设计板 402px 宽 → rpx = px × 1.8657
 *
 * ⚠️ 本文件**不出现 transform**：interaction-audit 对 scroll-view 内 hover 类只要匹配到
 *    `transform:`（哪怕值是 none）就判定「按压时画面抖动」。按压反馈一律只用 opacity，
 *    hover 类统一用 app.wxss 里的 `-flat` 无位移版本。
 */

/* ============ 页面骨架 ============ */

.practice-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #fff;
  overflow: hidden;
}

/* ============ ① 页内标题 ============ */

.pra-head {
  flex: none;
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.pra-head-result {
  height: 128rpx;
}

.pra-back {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-left: -12rpx;
  margin-right: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: opacity 100ms ease;
}

/* 返回箭头用两条边框拼：左 + 下各一条再旋 45°，不额外引一张图 */
.pra-back-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
  border-left: 4rpx solid #141820;
  border-bottom: 4rpx solid #141820;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.pra-head-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.pra-head-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #141820;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pra-head-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9AA0A6;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============ ② 细进度条 ============ */

.pra-progress {
  flex: none;
  height: 4rpx;
  background: #EEF0F5;
}

.pra-progress-fill {
  height: 100%;
  background: #466BFF;
  border-radius: 0 4rpx 4rpx 0;
  transition: width 220ms ease;
}

/* ============ ③ 信息行 ============ */

.pra-meta {
  flex: none;
  display: flex;
  align-items: center;
  padding: 26rpx 40rpx 6rpx;
  box-sizing: border-box;
}

.pra-meta-index {
  font-size: 24rpx;
  font-weight: 600;
  color: #466BFF;
  margin-right: 16rpx;
}

.pra-meta-type {
  font-size: 21rpx;
  color: #9AA0A6;
  padding: 4rpx 14rpx;
  background: #F4F5F7;
  border-radius: 8rpx;
}

.pra-meta-timer {
  margin-left: auto;
  font-size: 21rpx;
  color: #9AA0A6;
  font-variant-numeric: tabular-nums;
}

/* ============ ④ 题目区（唯一滚动段） ============ */

.pra-body {
  flex: 1;
  min-height: 0;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.pra-body-pad {
  height: 48rpx;
}

.pra-content {
  display: flex;
  flex-direction: column;
  padding-top: 20rpx;
}

/* 「选项在题干上方」的自定义布局：只改 order，不重排 DOM（重排会让滚动位置跳） */
.pra-content-above .pra-stem {
  order: 2;
  margin-top: 36rpx;
}

.pra-content-above .pra-options {
  order: 1;
}

.pra-stem {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #141820;
  margin-bottom: 48rpx;
}

.pra-options {
  display: flex;
  flex-direction: column;
}

/* 选项：白底卡片 + 字母圆标。选中 / 答对 / 答错三态靠底色 + 描边区分 */
.pra-option {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  background: #fff;
  border: 2rpx solid #EFEFEF;
  border-radius: 24rpx;
  transition: opacity 100ms ease, background-color 160ms ease, border-color 160ms ease;
}

.pra-option-hover {
  opacity: 0.62;
}

.pra-option-key {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  margin-right: 20rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
  background: #F4F5F7;
  border-radius: 50%;
  transition: background-color 160ms ease, color 160ms ease;
}

.pra-option-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  color: #141820;
}

/* 选中与答对共用绿色系，答错用橙色。
   顺序很重要：越靠后权重越高，保证「选了且错了」显示橙色而不是绿色 */
.pra-option.is-selected,
.pra-option.is-correct {
  background: #F1F9F6;
  border-color: #0DAD69;
}

.pra-option.is-selected .pra-option-key,
.pra-option.is-correct .pra-option-key {
  color: #fff;
  background: #0DAD69;
}

.pra-option.is-wrong {
  background: #FFF1E6;
  border-color: #F79009;
}

.pra-option.is-wrong .pra-option-key {
  color: #fff;
  background: #F79009;
}

/* ============ ⑤ 解析 ============ */

.pra-analysis {
  margin-top: 12rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #F2F3F5;
}

.pra-analysis-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.pra-result-tag {
  flex: none;
  font-size: 21rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.pra-result-tag.ok {
  color: #0DAD69;
  background: #F1F9F6;
}

.pra-result-tag.no {
  color: #F79009;
  background: #FFF1E6;
}

.pra-analysis-answer {
  flex: 1;
  font-size: 24rpx;
  color: #6B7280;
}

.pra-side-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #141820;
  margin-bottom: 10rpx;
}

/* 长解析默认收到 5 行，避免把选项挤出屏幕（设计稿「剩下的收起来了」） */
.pra-explanation-text {
  display: -webkit-box;
  font-size: 25rpx;
  line-height: 1.75;
  color: #6B7280;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
}

.pra-explanation.is-open .pra-explanation-text {
  -webkit-line-clamp: 99;
}

.pra-explanation-toggle {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #466BFF;
  transition: opacity 100ms ease;
}

.pra-explanation-muted {
  font-size: 23rpx;
  color: #9AA0A6;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
}

/* ============ ⑥ 底部工具行 + 两个按钮 ============ */

.pra-footer {
  flex: none;
  padding: 12rpx 40rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pra-tools {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

/* 三个 pill 按内容宽度靠左排（设计稿如此，不是平分整行） */
.pra-tool {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 26rpx;
  margin-right: 16rpx;
  background: #fff;
  border: 2rpx solid #EFEFEF;
  border-radius: 14rpx;
  transition: opacity 100ms ease, background-color 160ms ease, border-color 160ms ease;
}

.pra-tool:last-child {
  margin-right: 0;
}

.pra-tool.on {
  background: #F2F6FF;
  border-color: #C9D8FF;
}

.pra-tool.marked {
  background: #FFF6E8;
  border-color: #FFD9A6;
}

.pra-tool-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.pra-tool-text {
  font-size: 22rpx;
  color: #6B7280;
}

.pra-tool.on .pra-tool-text {
  color: #466BFF;
  font-weight: 600;
}

.pra-tool.marked .pra-tool-text {
  color: #F79009;
  font-weight: 600;
}

/* 图标 base64 内联：微信不支持本地 .svg 的 background-image（见 AGENTS.md） */
.icon-star {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-star.on {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-grid {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-pen {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-pen.on {
  background-image: url("data:image/svg+xml;base64,");
}

.pra-actions {
  display: flex;
  align-items: center;
}

/* 两个按钮严格等宽：flex:1 + 只有后一个留左边距 */
.pra-btn {
  flex: 1;
  height: 92rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 500;
  color: #466BFF;
  background: #fff;
  border: 2rpx solid #466BFF;
  border-radius: 18rpx;
  box-sizing: border-box;
  transition: opacity 100ms ease;
}

.pra-btn + .pra-btn {
  margin-left: 24rpx;
}

.pra-btn.primary {
  color: #fff;
  background: #466BFF;
  border-color: #466BFF;
}

.pra-btn.is-disabled {
  color: #C2C6CC;
  border-color: #E6E8EC;
}

.pra-btn.highlight {
  color: #fff;
  background: #F79009;
  border-color: #F79009;
}

/* ============ ⑦ 未答完的二次确认 ============ */

.pra-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pra-modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 22, 33, 0.45);
}

.pra-modal-panel {
  position: relative;
  width: 600rpx;
  padding: 44rpx 40rpx 36rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
}

.pra-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #141820;
}

.pra-modal-desc {
  margin-top: 16rpx;
  margin-bottom: 36rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #6B7280;
}

.pra-modal-actions {
  display: flex;
}

/* ============ ⑧ 结果页 ============ */

.pra-result {
  flex: 1;
  min-height: 0;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.pra-submit-error {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  background: #FFF1E6;
  border-radius: 16rpx;
}

.pra-submit-error-text {
  flex: 1;
  font-size: 23rpx;
  color: #C2410C;
}

.pra-submit-retry {
  flex: none;
  margin-left: 20rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #F79009;
  transition: opacity 100ms ease;
}

/* 蓝色渐变统计卡：三格数据 + 两条细分隔线 */
.res-card {
  display: flex;
  align-items: center;
  padding: 34rpx 24rpx;
  background: linear-gradient(135deg, #466BFF 0%, #6D8BFF 100%);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(70, 107, 255, 0.24);
}

.res-card-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.res-card-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.res-card-label {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.8);
}

.res-card-split {
  width: 2rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.28);
}

/* 答题明细 */
.res-detail {
  margin-top: 36rpx;
}

.res-detail-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.res-detail-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #141820;
}

.res-detail-sub {
  margin-left: auto;
  font-size: 21rpx;
  color: #9AA0A6;
}

.res-legend {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 22rpx;
}

.res-legend-item {
  display: flex;
  align-items: center;
  margin-right: 26rpx;
}

.res-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.res-mark-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: #F79009;
}

.dot-correct {
  background: #0DAD69;
}

.dot-wrong {
  background: #F79009;
}

.dot-pending {
  background: #DDE1E6;
}

.res-legend-text {
  font-size: 20rpx;
  color: #9AA0A6;
}

/* 6 列网格：固定宽 + 自动换行，第 6 个去掉右边距 */
.res-grid {
  display: flex;
  flex-wrap: wrap;
}

.res-cell {
  position: relative;
  flex: 0 0 auto;
  /* 6 格正好铺满一行：(100% - 5×间距) / 6。写死 88rpx 会剩一条右边空档 */
  width: calc((100% - 75rpx) / 6);
  height: 88rpx;
  margin-right: 15rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #F4F5F7;
  transition: opacity 100ms ease;
}

.res-cell:nth-child(6n) {
  margin-right: 0;
}

.res-cell-number {
  font-size: 25rpx;
  font-weight: 600;
  color: #6B7280;
}

.res-cell.cell-correct {
  background: #B6E7D2;
}

.res-cell.cell-correct .res-cell-number {
  color: #17845A;
}

.res-cell.cell-wrong {
  background: #FFE0C2;
}

.res-cell.cell-wrong .res-cell-number {
  color: #B45309;
}

/* 标记点：右上角小橙点，不遮题号 */
.res-cell-mark {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #F79009;
}

.cell-flat-hover {
  opacity: 0.6;
}

.res-actions {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

.res-actions-extra {
  margin-top: 20rpx;
}

/* ============ ⑨ 逐题回顾 ============ */

.res-review {
  margin-top: 44rpx;
}

.res-review-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #141820;
  margin-bottom: 22rpx;
}

.res-review-bar {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.res-filters {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.res-filter {
  padding: 10rpx 22rpx;
  margin-right: 14rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #6B7280;
  background: #F4F5F7;
  border-radius: 999rpx;
  transition: opacity 100ms ease, background-color 160ms ease, color 160ms ease;
}

.res-filter.active {
  color: #fff;
  background: #466BFF;
  font-weight: 600;
}

.res-search {
  height: 76rpx;
  padding: 0 26rpx;
  font-size: 25rpx;
  color: #141820;
  background: #F7F8FA;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.res-search-ph {
  color: #B0B6BE;
}

.res-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9AA0A6;
}

.res-item {
  padding: 26rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border: 2rpx solid #EFEFEF;
  border-radius: 20rpx;
  transition: opacity 100ms ease;
}

.res-item-hover {
  opacity: 0.62;
}

.res-item.is-wrong {
  border-color: #FFE0C2;
}

.res-item-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.res-item-number {
  font-size: 24rpx;
  font-weight: 600;
  color: #141820;
  margin-right: 14rpx;
}

.res-item-type {
  font-size: 20rpx;
  color: #9AA0A6;
  padding: 2rpx 12rpx;
  background: #F4F5F7;
  border-radius: 6rpx;
}

.res-item-flag {
  margin-left: auto;
  font-size: 21rpx;
  font-weight: 600;
}

.res-item-flag.ok {
  color: #0DAD69;
}

.res-item-flag.no {
  color: #F79009;
}

.res-item-flag.skip {
  color: #9AA0A6;
}

.res-item-stem {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #141820;
  margin-bottom: 16rpx;
}

.res-item-line {
  display: flex;
  margin-top: 10rpx;
}

.res-item-label {
  flex: none;
  width: 128rpx;
  font-size: 22rpx;
  color: #9AA0A6;
}

.res-item-value {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.6;
  color: #6B7280;
}

.res-item-value.is-correct {
  color: #0DAD69;
}

/* ============ ⑩ 字号档位（项目约定：档差 ≥8rpx） ============ */

.font-small .pra-stem {
  font-size: 27rpx;
}

.font-small .pra-option-text {
  font-size: 24rpx;
}

.font-small .pra-explanation-text {
  font-size: 21rpx;
}

.font-small .res-item-stem {
  font-size: 22rpx;
}

.font-small .res-item-value {
  font-size: 21rpx;
}

.font-large .pra-stem {
  font-size: 40rpx;
}

/* 字母圆标是固定尺寸的圆圈，字号变大时圈也得放大，否则字会顶边 */
.font-large .pra-option-key {
  width: 58rpx;
  height: 58rpx;
  line-height: 58rpx;
  font-size: 30rpx;
}

.font-large .pra-option-text {
  font-size: 34rpx;
}

.font-large .pra-analysis-answer {
  font-size: 28rpx;
}

.font-large .pra-explanation-text {
  font-size: 31rpx;
}

.font-large .res-item-stem {
  font-size: 32rpx;
}

.font-large .res-item-value {
  font-size: 29rpx;
}
