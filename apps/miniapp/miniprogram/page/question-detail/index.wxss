.detail-page {
  min-height: 100vh;
  background: #f4f7fb;
}

.detail-loading,
.detail-empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8a94a6;
}

.detail-area {
  height: 100vh;
  padding: 24rpx 24rpx 60rpx;
}

.detail-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-type {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(43, 127, 252, 0.12);
  color: var(--brand-dark);
  font-size: 22rpx;
}

.detail-source {
  flex: 1;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.detail-stem {
  display: block;
  font-size: 30rpx;
  line-height: 1.7;
  color: #1f2a37;
}

.detail-option {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #f7f9fc;
}

.detail-option.correct {
  background: rgba(29, 158, 117, 0.12);
}

.detail-option.wrong {
  background: rgba(163, 45, 45, 0.1);
}

.detail-option-label {
  flex-shrink: 0;
  width: 40rpx;
  font-size: 28rpx;
  color: var(--brand-dark);
}

.detail-option-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1f2a37;
}

.answer-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.answer-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 26rpx;
  color: #8a94a6;
}

.answer-value {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1f2a37;
}

.answer-value.ok {
  color: #0f6e56;
}

.answer-value.no {
  color: #a32d2d;
}

.correct-value {
  color: #0f6e56;
}

.answer-flag {
  padding: 14rpx 0 0;
  font-size: 26rpx;
}

.answer-flag.ok {
  color: #0f6e56;
}

.answer-flag.no {
  color: #a32d2d;
}

.explain-text {
  display: block;
  font-size: 27rpx;
  line-height: 1.7;
  color: #4a5568;
}

.favorite-btn {
  margin-top: 24rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  background: #ffffff;
  border: 2rpx solid rgba(43, 127, 252, 0.3);
  color: var(--brand-dark);
}

.favorite-btn.active {
  background: rgba(43, 127, 252, 0.12);
  border-color: rgba(43, 127, 252, 0.5);
}
