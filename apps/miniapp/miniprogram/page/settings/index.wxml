<view class="page settings-page">
  <view class="section-head"><text class="section-title">答题偏好</text><text class="section-reset" bindtap="handleResetPreferences" hover-class="ghost-flat-hover" hover-start-time="0" hover-stay-time="80">恢复默认</text></view>
  <view class="menu card">
    <view class="menu-row" wx:for="{{switches}}" wx:key="key">
      <view class="menu-main"><text class="menu-title">{{item.label}}</text><text class="menu-desc">{{item.description}}</text></view>
      <switch class="menu-switch" checked="{{item.value}}" color="#2b7ffc" data-key="{{item.key}}" bindchange="handleSwitchChange" />
    </view>
  </view>
  <view class="menu card choice-card">
    <view class="choice-row" wx:for="{{choices}}" wx:key="key">
      <text class="menu-title">{{item.label}}</text><text class="menu-desc">{{item.description}}</text>
      <view class="choice-options">
        <view wx:for="{{item.options}}" wx:for-item="option" wx:key="value" class="choice-chip {{option.selected ? 'active' : ''}}" data-key="{{item.key}}" data-value="{{option.value}}" bindtap="handleChoiceTap" hover-class="chip-flat-hover" hover-start-time="0" hover-stay-time="80">{{option.label}}</view>
      </view>
      <view class="font-preview font-{{fontSize}}"><text class="font-preview-text">{{fontPreviewText}}</text></view>
    </view>
  </view>
</view>
