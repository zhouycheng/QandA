<!-- 复盘页｜设计稿「复盘 / 错题本 / 收藏本」三画板的第一屏（402x874，系数 750/402 ≈ 1.8657）
     标题 + 区间切换 + 三个数字 + 错题本/收藏本两张入口卡 + 学习活动热力图 + 答题趋势。
     tab 文案叫「复盘」，路由仍是 page/stats/index。 -->
<view class="list-page review-page">
  <view class="page-head">
    <view class="page-head-main">
      <text class="page-head-title">复盘</text>
      <text class="review-sub">{{identity.subtitle}}</text>
    </view>
  </view>

  <!-- 区间切换：近 7 天 / 近 30 天 / 累计 -->
  <view class="segmented">
    <view
      class="seg {{range === item.value ? 'seg-active' : ''}}"
      wx:for="{{rangeOptions}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="handleRangeTap"
      hover-class="seg-hover"
      hover-start-time="0"
      hover-stay-time="240"
    >{{item.label}}</view>
  </view>

  <view class="metric-row">
    <view class="metric">
      <text class="metric-label">题量</text>
      <view class="metric-value">
        <text class="metric-num">{{metrics.answered}}</text>
        <text class="metric-unit">道</text>
      </view>
    </view>
    <view class="metric">
      <text class="metric-label">正确率</text>
      <view class="metric-value">
        <text class="metric-num">{{metrics.accuracy}}</text>
        <text class="metric-unit">%</text>
      </view>
    </view>
    <view class="metric">
      <text class="metric-label">学习时长</text>
      <view class="metric-value">
        <text class="metric-num">{{metrics.duration}}</text>
        <text class="metric-unit">分</text>
      </view>
    </view>
  </view>

  <!-- 错题本 / 收藏本：两个独立页面，各自带统计与练习入口 -->
  <view class="entry-row">
    <view
      class="entry-card entry-wrong"
      data-key="wrong"
      data-url="{{entries.wrong.url}}"
      bindtap="handleEntryTap"
      hover-class="entry-card-hover"
      hover-start-time="0"
      hover-stay-time="240"
    >
      <view class="entry-head">
        <view class="entry-icon entry-icon-wrong"></view>
        <text class="entry-title">错题本</text>
      </view>
      <view class="entry-value">
        <text class="entry-num">{{entries.wrong.value}}</text>
        <text class="entry-unit">{{entries.wrong.unit}}</text>
      </view>
      <text class="entry-caption">{{entries.wrong.caption}}</text>
    </view>

    <view
      class="entry-card entry-favorite"
      data-key="favorite"
      data-url="{{entries.favorite.url}}"
      bindtap="handleEntryTap"
      hover-class="entry-card-hover"
      hover-start-time="0"
      hover-stay-time="240"
    >
      <view class="entry-head">
        <view class="entry-icon entry-icon-favorite"></view>
        <text class="entry-title">收藏本</text>
      </view>
      <view class="entry-value">
        <text class="entry-num">{{entries.favorite.value}}</text>
        <text class="entry-unit">{{entries.favorite.unit}}</text>
      </view>
      <text class="entry-caption">{{entries.favorite.caption}}</text>
    </view>
  </view>

  <view class="block">
    <view class="block-head">
      <text class="block-title">学习活动</text>
      <text class="block-caption">近半年</text>
    </view>

    <!-- 热力图是整张 SVG 背景图，没有记录时也照画（灰格子本身就是「还没开始」的信息） -->
    <image class="heatmap" wx:if="{{activity.dataUri}}" src="{{activity.dataUri}}" mode="widthFix"></image>

    <view class="legend-row">
      <text class="legend-text">少</text>
      <view class="legend-cell {{item}}" wx:for="{{activity.legend}}" wx:key="*this"></view>
      <text class="legend-text">多</text>
    </view>
  </view>

  <view class="block">
    <view class="block-head">
      <text class="block-title">答题趋势</text>
      <text class="block-caption">{{trend.caption}}</text>
    </view>

    <image class="trend-chart" wx:if="{{trend.hasData}}" src="{{trend.dataUri}}" mode="widthFix"></image>
    <view class="chart-empty" wx:else>
      <text>这段时间还没有练习记录，做一套题就有曲线了</text>
    </view>
  </view>
</view>
