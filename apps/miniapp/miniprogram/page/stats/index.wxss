@import "../../styles/list-page.wxss";

/* 复盘页（设计稿「复盘」画板，402x874，系数 750/402 ≈ 1.8657）
   页边距来自 styles/list-page.wxss，这里只写这一页独有的灰底、卡片与图表。
   换算：22px 页边距 → 41rpx；14px 卡内边距 → 26rpx；12px 圆角 → 22rpx；
        34px 分段高 → 63rpx；24px 指标数字 → 45rpx。

   设计稿是「浅灰底 + 白卡」的层次，和「我的」那种纯白长页不一样：
   标题和三指标直接落在底色上，只有热力图与趋势图各占一张白卡。 */

.review-page {
  background: #f4f5f9;
  padding-bottom: 272rpx;
  padding-bottom: calc(272rpx + env(safe-area-inset-bottom));
}

.review-page .page-head {
  height: 128rpx;
  border-bottom: none;
  background: transparent;
}

.page-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 身份行：学院 · 昵称，紧跟在标题下面，是标题的延伸而不是另一块内容 */
.review-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 32rpx;
  font-weight: 500;
  color: #8b8f99;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 区间切换 ---------- */

.segmented {
  display: flex;
  align-items: center;
  height: 63rpx;
  margin-top: 8rpx;
  padding: 6rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #ffffff;
}

.seg {
  flex: 1;
  height: 51rpx;
  border-radius: 15rpx;
  font-size: 22rpx;
  line-height: 51rpx;
  font-weight: 500;
  color: #6b7684;
  text-align: center;
  transition: background-color 0.16s ease, color 0.16s ease;
}

.seg-hover {
  opacity: 0.7;
}

/* 选中态：蓝色胶囊 + 白字。蓝底白字对比度足够，不要再叠透明度 */
.seg-active {
  background: #466bff;
  color: #ffffff;
  font-weight: 600;
}

/* ---------- 三个指标 ---------- */

.metric-row {
  display: flex;
  align-items: flex-start;
  margin-top: 30rpx;
}

.metric {
  flex: 1;
  min-width: 0;
}

.metric-label {
  display: block;
  font-size: 21rpx;
  line-height: 32rpx;
  font-weight: 500;
  color: #8b8f99;
}

.metric-value {
  display: flex;
  align-items: baseline;
  margin-top: 2rpx;
}

.metric-num {
  font-size: 45rpx;
  line-height: 62rpx;
  font-weight: 700;
  color: #141820;
}

.metric-unit {
  margin-left: 3rpx;
  font-size: 21rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: #141820;
}

/* ---------- 错题本 / 收藏本入口卡 ---------- */

.entry-row {
  display: flex;
  margin-top: 26rpx;
}

.entry-card {
  flex: 1;
  min-width: 0;
  padding: 22rpx 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  transition: opacity 0.1s ease;
}

/* 两张卡一左一右，右边固定 margin-left 而不是 gap —— WXSS 的 gap 在旧机型上不生效 */
.entry-card + .entry-card {
  margin-left: 24rpx;
}

.entry-card-hover {
  opacity: 0.72;
}

.entry-wrong {
  background: #fdeef0;
}

.entry-favorite {
  background: #eef3ff;
}

.entry-head {
  display: flex;
  align-items: center;
}

.entry-icon {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.entry-icon-wrong {
  background-image: url("data:image/svg+xml;base64,");
}

.entry-icon-favorite {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlLXdpZHRoPSIxLjciIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBhdGggZD0iTTYuNiAzLjZoMTAuOHYxNi44TDEyIDE1LjlsLTUuNCA0LjV6IiBzdHJva2U9IiM0NjZCRkYiLz48L3N2Zz4=");
}

.entry-title {
  font-size: 21rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: #8b8f99;
}

.entry-value {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.entry-num {
  font-size: 38rpx;
  line-height: 52rpx;
  font-weight: 700;
  color: #141820;
}

.entry-unit {
  margin-left: 4rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  font-weight: 600;
  color: #141820;
}

.entry-caption {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  line-height: 28rpx;
  font-weight: 500;
  color: #a0a5af;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 图表白卡 ---------- */

.block {
  margin-top: 26rpx;
  padding: 26rpx 26rpx 22rpx;
  border-radius: 26rpx;
  background: #ffffff;
}

.block-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.block-title {
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 700;
  color: #141820;
}

.block-caption {
  margin-left: auto;
  font-size: 20rpx;
  line-height: 32rpx;
  font-weight: 500;
  color: #8b8f99;
}

/* 两张图都按宽度铺满：SVG 的 viewBox 比例固定，宽度交给容器 */
.heatmap {
  display: block;
  width: 100%;
}

/* 趋势图给固定高度：mode="widthFix" 会让 640x240 的图在 600rpx 宽时压得很扁，
   曲线糊成一条。190rpx ≈ 设计稿里 100px 的绘图区高度。 */
.trend-chart {
  display: block;
  width: 100%;
  height: 190rpx;
}

/* ---------- 热力图图例 ---------- */

.legend-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.legend-text {
  font-size: 19rpx;
  line-height: 28rpx;
  color: #8b8f99;
}

.legend-cell {
  width: 22rpx;
  height: 22rpx;
  margin: 0 4rpx;
  border-radius: 5rpx;
}

.legend-cell.lv-0 {
  background: #f0f2f5;
}

.legend-cell.lv-1 {
  background: #dbe6ff;
}

.legend-cell.lv-2 {
  background: #b8cdff;
}

.legend-cell.lv-3 {
  background: #8aabfc;
}

.legend-cell.lv-4 {
  background: #4f7dfb;
}

/* ---------- 空态 ---------- */

.chart-empty {
  padding: 40rpx 0;
  font-size: 21rpx;
  line-height: 34rpx;
  color: #8b8f99;
  text-align: center;
}
