.stats-page {
  padding: 24rpx 24rpx 60rpx;
}

/* ==================== 总览（环形进度） ==================== */
.hero {
  padding: 30rpx 28rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #4f7dfb 0%, #2bb3fc 100%);
  box-shadow: 0 16rpx 34rpx rgba(43, 127, 252, 0.28);
}

.hero-top {
  display: flex;
  align-items: center;
}

/* 环形进度：SVG 当背景图，尺寸与 viewBox 等比（240 × 240） */
.hero-ring {
  flex: none;
  width: 200rpx;
  height: 200rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.hero-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.hero-headline {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
}

.hero-chips {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  margin-right: -12rpx;
}

.hero-chip {
  margin: 0 12rpx 10rpx 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 21rpx;
  color: #ffffff;
}

.hero-stats {
  margin-top: 26rpx;
  padding-top: 22rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}

.hero-stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-stat-value {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #ffffff;
}

.hero-stat-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* ==================== 区块通用 ==================== */
.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 6rpx 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.section-note {
  font-size: 22rpx;
  color: var(--text-muted);
}

.chart-card {
  padding: 24rpx 0 20rpx;
  overflow: hidden;
}

.chart-empty {
  padding: 60rpx 40rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
}

.chart-empty.plain {
  padding: 60rpx 24rpx;
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 42, 55, 0.06);
}

/* ==================== 雷达图 ==================== */
.radar-head {
  padding: 0 26rpx 8rpx;
  display: flex;
  align-items: center;
}

.radar-score {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 26rpx 10rpx 0;
  border-right: 1rpx solid var(--line);
}

.radar-score-value {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--brand);
}

.radar-score-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--text-muted);
}

.radar-tags {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.radar-tag {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
}

.radar-tag + .radar-tag {
  margin-top: 12rpx;
}

.radar-tag-key {
  font-size: 21rpx;
}

.radar-tag-value {
  font-size: 23rpx;
  font-weight: 600;
}

.tag-good {
  background: #e9fbf1;
}

.tag-good .radar-tag-key {
  color: #0e8c53;
}

.tag-good .radar-tag-value {
  color: #0e8c53;
}

.tag-weak {
  background: #fff5e6;
}

.tag-weak .radar-tag-key {
  color: #b25e00;
}

.tag-weak .radar-tag-value {
  color: #b25e00;
}

/* 620 × 410 的 viewBox 按 702rpx 展示，高度等比放大 */
.radar-chart {
  width: 100%;
  height: 464rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

/* ==================== 趋势图 ==================== */
.trend-chart {
  width: 100%;
  height: 329rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.legend {
  margin-top: 14rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.dot-answered {
  background: #2b7ffc;
}

.dot-correct {
  background: #17b26a;
}

.legend-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ==================== 科目进度 ==================== */
.subject-list {
  padding: 8rpx 26rpx;
}

.subject-row {
  padding: 24rpx 0;
}

.subject-row + .subject-row {
  border-top: 1rpx solid var(--line);
}

.subject-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.subject-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.dot-chinese {
  background: #f04438;
}

.dot-mental {
  background: #17b26a;
}

.dot-english {
  background: #2b7ffc;
}

.dot-user {
  background: #6941c6;
}

.subject-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.subject-meta {
  flex: none;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.subject-accuracy {
  flex: none;
  margin-left: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.acc-good {
  color: #0e8c53;
  background: #e9fbf1;
}

.acc-mid {
  color: #b25e00;
  background: #fff5e6;
}

.acc-low {
  color: #b42318;
  background: #fef3f2;
}

.acc-none {
  color: var(--text-muted);
  background: #f2f4f7;
}

.progress-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: #eef2f8;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #53b1fd, #2b7ffc);
  transition: width 0.3s ease;
}

/* 科目主题色，与首页横幅、题库列表保持一致 */
.fill-chinese {
  background: linear-gradient(90deg, #f97066, #f04438);
}

.fill-mental {
  background: linear-gradient(90deg, #32d583, #17b26a);
}

.fill-english {
  background: linear-gradient(90deg, #53b1fd, #2b7ffc);
}

.fill-user {
  background: linear-gradient(90deg, #9b8afb, #6941c6);
}

/* ==================== 错题与收藏 ==================== */
.grid {
  display: flex;
}

.grid-item {
  flex: 1;
  min-width: 0;
  padding: 24rpx 0 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-item + .grid-item {
  margin-left: 16rpx;
}

.grid-icon {
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.grid-icon-wrong {
  background-image: url("data:image/svg+xml;base64,");
}

.grid-icon-done {
  background-image: url("data:image/svg+xml;base64,");
}

.grid-icon-star {
  background-image: url("data:image/svg+xml;base64,");
}

.grid-value {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
}

.value-danger {
  color: #f04438;
}

.value-success {
  color: #17b26a;
}

.value-warning {
  color: #f79009;
}

.grid-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-muted);
}

/* ==================== 历史最佳 ==================== */
.records {
  padding: 8rpx 26rpx;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.record-row + .record-row {
  border-top: 1rpx solid var(--line);
}

.record-title {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: var(--text-sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-score {
  flex: none;
  margin-left: 20rpx;
  min-width: 92rpx;
  padding: 8rpx 0;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.score-good {
  color: #0e8c53;
  background: #e9fbf1;
}

.score-mid {
  color: #b25e00;
  background: #fff5e6;
}

.score-low {
  color: #b42318;
  background: #fef3f2;
}
