<!-- 首页（原型 552:1410）
     结构：蓝色头部（品牌 + 搜索 + 公告圆钮）→ 白色圆角内容区（倒计时卡 + 四宫格）
     头部与内容区之间靠负 margin 咬合，内容区圆角把蓝底"切"出一道弧，不需要额外装饰图。 -->
<view class="page home-page stagger">
  <view class="hero" style="padding-top: {{homeStatusBarHeight}}px;">
    <view class="hero-navigation" style="height: {{homeNavigationBarHeight}}px;">
      <view class="hero-brand">QandA</view>
    </view>

    <view class="hero-search">
      <view
        class="search-box"
        bindtap="handleOpenSearch"
        hover-class="search-box-hover"
        hover-start-time="0"
        hover-stay-time="240"
      >
        <input
          class="search-input"
          value="{{searchKeyword}}"
          placeholder="搜索题目、关键词"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindinput="handleSearchInput"
          bindconfirm="handleSearchConfirm"
          bindfocus="handleOpenSearch"
        />
        <!-- 输入框里的放大镜只做视觉，热区是整条搜索框 -->
        <view class="search-icon"></view>
      </view>

      <!-- 有可见公告时，喇叭持续摇动。 -->
      <view
        class="hero-notice-btn"
        aria-role="button"
        aria-label="{{hasAnnouncements ? '查看公告' : '暂无公告'}}"
        bindtap="handleAnnouncementTap"
        hover-class="hero-notice-hover"
        hover-start-time="0"
        hover-stay-time="240"
      >
        <view class="hero-notice-circle"></view>
        <image class="hero-notice-icon {{hasAnnouncements ? 'hero-notice-icon-active' : ''}}" src="/assets/home/announcement-megaphone.png" mode="aspectFit"></image>
        <text class="hero-notice-label">公告</text>
      </view>
    </view>
  </view>

  <view class="sheet">
    <!-- 考试倒计时：未设置时整张卡变成「去设置」引导，不显示 0 天 -->
    <view
      class="exam-card"
      bindtap="handleExamTap"
      hover-class="exam-card-hover"
      hover-start-time="0"
      hover-stay-time="240"
    >
      <!-- 底图 + 左侧压暗层：插画只在右侧，压暗层保证左边文字始终读得清。
           底图早/中/晚三张，由 home.coverImage 按时段给（utils/home-content.js），
           三张用同一个裁剪窗口，换图时书本与时钟不会在卡片里跳位置。 -->
      <image class="exam-cover" src="{{home.coverImage}}" mode="aspectFill"></image>
      <view class="exam-veil"></view>

      <view class="exam-body">
        <view class="exam-head">
          <text class="exam-greeting">{{home.greeting}}</text>
          <text class="exam-date">{{home.dateText}}</text>
        </view>

        <!-- 四种状态互斥，顺序不能换：
             已结束 → 就是今天 → 还有 N 天 → 未设置。
             把「就是今天」并进「还有 N 天」会渲染成「距离 X 考试还有 就是今天 天」。 -->
        <view class="exam-main" wx:if="{{exam.configured && exam.isPast}}">
          <text class="exam-text">{{exam.examName}} 考试已结束</text>
        </view>

        <view class="exam-main exam-main-today" wx:elif="{{exam.configured && exam.isExamDay}}">
          <text class="exam-text">{{exam.examName}}</text>
          <text class="exam-days exam-days-today">就在今天</text>
        </view>

        <view class="exam-main" wx:elif="{{exam.configured}}">
          <!-- 不再拼「考试」二字：用户填的名称本身常带「考试」（期末考试），
               拼上去会变成「距离 期末考试 考试还有」，重复且更长 -->
          <text class="exam-text">距离 {{exam.examName}} 还有</text>
          <text class="exam-days">{{exam.dayText}}</text>
          <text class="exam-text">天</text>
        </view>

        <view class="exam-main exam-main-empty" wx:else>
          <text class="exam-text">设置考试倒计时</text>
        </view>

        <view class="exam-foot">
          <!-- 每日一句在这里，不再单独占一个弹层 -->
          <text class="exam-quote">{{home.quote}}</text>
          <!-- 已设置时这里是「修改」而不是状态文案：状态已经在主行说完了，
               再挂一个「天」字上去只会重复。 -->
          <text class="exam-action">{{exam.configured ? '修改' : exam.statusText}}</text>
        </view>
      </view>
    </view>

    <view class="section-head">
      <text class="section-title">我的学习空间</text>
    </view>

    <view class="entry-grid">
      <view
        wx:for="{{entries}}"
        wx:key="key"
        class="entry"
        data-key="{{item.key}}"
        bindtap="handleEntryTap"
        hover-class="entry-hover"
        hover-start-time="0"
        hover-stay-time="240"
      >
        <view class="entry-icon entry-icon-{{item.key}}">
          <view class="entry-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
        </view>
        <text class="entry-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 底部说明：原型留白处放一条状态提示，空着会显得页面没写完 -->
    <view class="home-foot" wx:if="{{overall}}">
      <text class="home-foot-text">已做 {{overall.answered}} / {{overall.total}} 题 · 正确率 {{overall.accuracyText}}</text>
    </view>
  </view>

  <!-- 搜索结果面板：输入即搜，完全本地 -->
  <view class="search-panel" wx:if="{{searchVisible}}">
    <view class="search-mask" bindtap="handleSearchClose"></view>

    <view class="search-panel-body">
      <view class="search-panel-head">
        <text class="search-panel-title">搜索题目</text>
        <text class="search-panel-close" bindtap="handleSearchClose">关闭</text>
      </view>

      <scroll-view class="search-list" scroll-y enhanced bounces show-scrollbar="{{false}}">
        <view
          wx:for="{{searchResults}}"
          wx:key="questionId"
          class="search-item"
          data-id="{{item.questionId}}"
          bindtap="handleSearchResultTap"
          hover-class="search-item-hover"
          hover-start-time="0"
          hover-stay-time="240"
        >
          <text class="search-item-stem">{{item.stem}}</text>
          <text class="search-item-meta">{{item.typeText}}<text wx:if="{{item.sourceText}}"> · {{item.sourceText}}</text></text>
        </view>

        <view wx:if="{{searchLoading}}" class="search-empty"><text>正在搜索…</text></view>
        <view wx:if="{{searchHasMore && !searchLoading}}" class="search-item" bindtap="handleSearchMore" hover-class="search-item-hover" hover-start-time="0"><text>加载更多</text></view>

        <view class="search-empty" wx:if="{{searchSearched && searchResultCount === 0}}">
          <text class="search-empty-title">没有找到匹配的题目</text>
          <text class="search-empty-tip">试试更短的关键词，比如题干的头两个字</text>
        </view>

        <view class="search-empty" wx:if="{{!searchSearched}}">
          <text class="search-empty-title">输入关键词开始搜索</text>
          <text class="search-empty-tip">{{searchTotalText}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 公告使用居中弹窗，打开时收起自定义 tabBar。 -->
  <bottom-sheet
    visible="{{announcementSheetVisible}}"
    title="公告"
    placement="center"
    bind:close="handleAnnouncementClose"
  >
    <view class="notice-sheet">
      <view class="notice-badge">
        <image class="notice-badge-icon" src="/assets/home/announcement-megaphone.png" mode="aspectFit"></image>
      </view>
      <view class="notice-item" wx:for="{{announcements}}" wx:key="id">
        <text class="notice-title">{{item.title}}</text>
        <text class="notice-body">{{item.body || item.summary}}</text>
      </view>
      <text class="notice-empty" wx:if="{{!hasAnnouncements}}">暂无公告</text>
    </view>
  </bottom-sheet>

  <route-loading
    visible="{{routeLoadingVisible}}"
    title="{{routeLoadingTitle}}"
    description="{{routeLoadingDescription}}"
  />
</view>
