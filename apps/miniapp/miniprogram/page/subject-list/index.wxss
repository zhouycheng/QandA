/* 首页（原型 552:1410）
   蓝头 + 白底圆角内容区。整页背景交给头部渐变，页面本身不留 padding，
   否则蓝色到不了屏幕边缘。 */
.home-page {
  padding: 0;
  background: #ffffff;
}

/* ==================== 蓝色头部 ==================== */

/**
 * 顶部导航栏已改成 #4A7BFB（见 index.json），这里必须用**垂直**渐变，
 * 且第一站就是同一个 #4A7BFB，否则导航栏和头部的交界处会露出一道色差。
 * 原来用的 160deg 是斜的，右上角已经过渡到偏深，接缝一眼能看出来。
 */
.hero {
  padding: 40rpx 36rpx 56rpx;
  background: linear-gradient(180deg, #4a7bfb 0%, #3566f0 62%, #2a58e6 100%);
}

.hero-brand {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
}

.hero-search {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
}

/* 白色搜索条：只有输入区可点，点空白处也算点输入框 */
.search-box {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.search-box-hover {
  opacity: 0.82;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  font-size: 27rpx;
  color: var(--text-main);
}

/* 微信 input 的 placeholder 不吃 color，必须用类 */
.search-placeholder {
  color: #b3bccb;
}

.search-icon {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMWYyYTM3IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS13aWR0aD0iMi4yIj48Y2lyY2xlIGN4PSIxMC42IiBjeT0iMTAuNiIgcj0iNi42Ii8+PGxpbmUgeDE9IjE1LjYiIHkxPSIxNS42IiB4Mj0iMjAuNSIgeTI9IjIwLjUiLz48L3N2Zz4=");
}

/* 右上角圆钮：公告（小喇叭）。每日一句已移到倒计时卡里。 */
.hero-notice-btn {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
}

.hero-notice-hover {
  opacity: 0.82;
}

/* 大喇叭：比常规图标大一号（52rpx），一进页面就晃，用来吸引注意。
   晃动的是图标本身而不是整个白圆 —— 白圆是正圆，转起来看不出动静。 */
.hero-notice-icon {
  width: 52rpx;
  height: 52rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,");
  animation: notice-shake 5s ease-in-out infinite;
}

/**
 * 晃动节奏：前 1.8s 里左右摆三次并轻微放大，剩下 3.2s 完全静止。
 * 不做「一直匀速抖」——那种会让人烦，而且整页都在动会干扰读搜索框。
 */
@keyframes notice-shake {
  0%,
  100% {
    transform: rotate(0deg);
  }

  6% {
    transform: rotate(-14deg) scale(1.06);
  }

  12% {
    transform: rotate(12deg) scale(1.08);
  }

  18% {
    transform: rotate(-9deg) scale(1.04);
  }

  24% {
    transform: rotate(6deg);
  }

  30% {
    transform: rotate(-3deg);
  }

  36% {
    transform: rotate(0deg);
  }
}

/* ==================== 白色内容区 ==================== */

/* 负 margin 让白圆角压住蓝底，形成原型里那道弧。
   底部 272rpx = tabbar 232 + 40 呼吸位，再叠加安全区。 */
.sheet {
  margin-top: -28rpx;
  padding: 36rpx 32rpx 272rpx;
  padding-bottom: calc(272rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: #ffffff;
}

/* ==================== 考试倒计时 ==================== */

/**
 * ⚠️ 高度写死，不用 min-height。
 *
 * 封面图是按 686:320 裁的，两者比例必须完全一致，否则 aspectFill 会裁掉边：
 * 之前高度随内容浮动，卡片比图「矮」时左右各被切掉一截，右边缘的时钟被切掉半个。
 * 改这里的 height，必须同步改 assets/home/exam-cover.jpg 的裁剪比例
 * （scripts/prepare-exam-cover.py 的 CARD_RATIO），tests/home-prototype.check.js 会比对。
 */
.exam-card {
  position: relative;
  overflow: hidden;
  height: 320rpx;
  padding: 30rpx 32rpx 28rpx;
  border-radius: 28rpx;
  /* 图片加载前的兜底底色，取封面图自身的深蓝，避免闪一下亮蓝 */
  background: linear-gradient(150deg, #4667c5 0%, #3f5eaf 55%, #1e3978 100%);
  box-shadow: 0 16rpx 36rpx rgba(31, 58, 140, 0.32);
}

/* 封面图铺满整卡（插画只占右侧，左侧本身就是纯色，靠压暗层统一） */
.exam-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/**
 * 压暗层：这是满幅底图上放白字的唯一原因。
 *
 * 早期底图是「左侧留空、插画在右」的矢量图，所以只做了一道从左到右的横向渐变。
 * 现在的底图是三张**满幅写实插画**（书房/图书馆/夜景），左半屏也有内容：
 *  - 横向量降到 .70 起步，让画面透出来，不再糊成一块死蓝；
 *  - 但只靠横向压不住底部那行金句和「修改」，所以补一道**自下而上**的纵向压暗，
 *    底边 .62 起、44% 处收干净——正好盖住金句行，中间的画面细节不受影响。
 * 字始终压在这两层之上，任何一张底图都不会读出「白字浮在亮处」。
 */
.exam-veil {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(90deg, rgba(17, 31, 82, 0.70) 0%, rgba(17, 31, 82, 0.56) 30%, rgba(17, 31, 82, 0.30) 58%, rgba(17, 31, 82, 0.10) 80%, rgba(17, 31, 82, 0) 100%),
    linear-gradient(0deg, rgba(11, 20, 56, 0.74) 0%, rgba(11, 20, 56, 0.46) 26%, rgba(11, 20, 56, 0.14) 42%, rgba(11, 20, 56, 0) 56%);
}

/* 内容层压在封面图与压暗层之上。
   纵向三等分撑满：问候语贴顶、倒计时居中、金句贴底，高度固定时上下不会留一块空。 */
.exam-body {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 卡片本身是大色块，按压只改不透明度：
   改背景会盖掉插画，加 transform 会让整块卡位移 */
.exam-card-hover {
  opacity: 0.9;
}

.exam-head {
  display: flex;
  align-items: baseline;
}

.exam-greeting {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.exam-date {
  margin-left: 14rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* 左对齐（不再居中）：插画占右侧约三分之一，居中的倒计时会压到书本和时钟上。
   纵向间距由 .exam-body 的 space-between 负责，这里不再写 margin-top。 */
.exam-main {
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
}

.exam-main-empty {
  /* 未设置时只有一行字，靠 space-between 会被拉到正中，这里让它回到偏上的位置 */
  margin-top: -40rpx;
}

/* 「就在今天」是四个字，不能套用天数那套 56rpx 大号 */
.exam-days-today {
  margin-left: 14rpx;
  font-size: 40rpx;
}

.exam-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.exam-days {
  margin: 0 10rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #ffffff;
  letter-spacing: -1rpx;
}

.exam-foot {
  display: flex;
  align-items: flex-end;
}

/* 每日一句：压两行截断，避免长句把卡片撑高、把插画挤到看不见 */
.exam-quote {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.86);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.exam-action {
  flex: none;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  font-size: 21rpx;
  color: #ffffff;
}

/* ==================== 我的学习空间 ==================== */

.section-head {
  margin-top: 40rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* 四宫格：一个 flex 行 + flex:1 等分（不用 flex-wrap + calc，避免小数像素塌成一行一个） */
.entry-grid {
  margin-top: 22rpx;
  padding: 30rpx 10rpx 26rpx;
  display: flex;
  border-radius: 28rpx;
  background: #f7f9fc;
}

.entry {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 20rpx;
}

.entry-hover {
  opacity: 0.62;
}

/* ===== 四宫格图标 =====
   四个入口各一种颜色（橙 / 绿 / 红 / 蓝），之前全是橙色、只靠形状区分，
   用户反馈「配色风格太统一了，不容易识别」。
   整块（圆角方块 + 渐变 + 白色字形）都由一张 SVG 画好，这里只管尺寸和投影，
   免得再用 ::after 叠一层、两套颜色还要手动对齐。 */
.entry-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

/* 投影取各自的主色，压在同色背景上也看得出层次 */
.entry-icon-recent {
  background-image: url("data:image/svg+xml;base64,");
  box-shadow: 0 8rpx 18rpx rgba(234, 142, 66, 0.3);
}

.entry-icon-mock {
  background-image: url("data:image/svg+xml;base64,");
  box-shadow: 0 8rpx 18rpx rgba(84, 198, 158, 0.3);
}

.entry-icon-wrong {
  background-image: url("data:image/svg+xml;base64,");
  box-shadow: 0 8rpx 18rpx rgba(233, 106, 101, 0.3);
}

.entry-icon-favorite {
  background-image: url("data:image/svg+xml;base64,");
  box-shadow: 0 8rpx 18rpx rgba(90, 147, 238, 0.3);
}

/* 计数徽标压在图标右上角 */
.entry-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 9rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f04438;
  border: 3rpx solid #ffffff;
  font-size: 19rpx;
  font-weight: 600;
  color: #ffffff;
}

.entry-label {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-main);
}

.home-foot {
  margin-top: 40rpx;
  text-align: center;
}

.home-foot-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ==================== 搜索结果面板 ==================== */

.search-panel {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
}

.search-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 36, 0.35);
}

/* 面板从顶部弹出：搜索框在头部，结果贴着它出现比从底部滑上来更自然 */
.search-panel-body {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 300rpx;
  max-height: 62vh;
  display: flex;
  flex-direction: column;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 36, 0.2);
  overflow: hidden;
}

.search-panel-head {
  flex: none;
  padding: 26rpx 28rpx 18rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--line);
}

.search-panel-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.search-panel-close {
  flex: none;
  padding: 8rpx 4rpx 8rpx 20rpx;
  font-size: 25rpx;
  color: var(--brand);
}

.search-list {
  flex: 1;
  min-height: 200rpx;
  max-height: 52vh;
}

.search-item {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.search-item-hover {
  opacity: 0.62;
}

.search-item-stem {
  display: block;
  font-size: 27rpx;
  line-height: 1.55;
  color: var(--text-main);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.search-item-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--text-muted);
}

.search-empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.search-empty-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
}

.search-empty-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ==================== 公告弹层 ==================== */

.notice-sheet {
  padding: 0 4rpx 8rpx;
}

/* 弹窗顶部的喇叭徽标：与入口同一个图形，让「点的是它、弹出来的是它」对得上 */
.notice-badge {
  width: 96rpx;
  height: 96rpx;
  margin: 8rpx auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf2ff;
}

.notice-badge-icon {
  width: 52rpx;
  height: 52rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml;base64,");
}

.notice-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.55;
  text-align: center;
  color: var(--text-main);
}

.notice-body {
  display: block;
  margin-top: 20rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: var(--text-sub);
  white-space: pre-wrap;
}

.notice-btn {
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4f7dfb, #2b7ffc);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(43, 127, 252, 0.28);
}

.notice-btn-hover {
  opacity: 0.86;
}
