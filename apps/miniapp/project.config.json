{
  "description": "QandA 小程序端项目配置。真实微信登录需要后端身份配置与小程序合法请求域名；API 地址通过扩展配置 apiBaseUrl 提供。",
  "compileType": "miniprogram",
  "libVersion": "3.15.2",
  "appid": "wx11da32e72feccf06",
  "projectname": "QandA-miniapp",
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "",
  "packOptions": {
    "ignore": [
      {
        "value": "node_modules",
